        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/outline_dark</item>
        <item name="colorOutlineVariant">@color/outline_variant_dark</item>

        <item name="materialSwitchStyle">@style/Widget.InstaEclipse.Switch</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.InstaEclipse.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.InstaEclipse.BottomSheet</item>
