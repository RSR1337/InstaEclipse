<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InstaEclipse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/ie_nav_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="fontFamily">@font/ie_sans</item>
        <item name="android:fontFamily">@font/ie_sans</item>

        <item name="colorPrimary">@color/corona_amber</item>
        <item name="colorOnPrimary">@color/corona_amber_on</item>
        <item name="colorSecondary">@color/text_secondary_light</item>
        <item name="colorError">@color/ie_danger</item>
        <item name="colorOnError">@color/ie_on_danger</item>
        <item name="colorPrimaryContainer">#FCEBC7</item>
        <item name="colorOnPrimaryContainer">#3A2700</item>
        <item name="colorSecondaryContainer">@color/surface_2_light</item>
        <item name="colorOnSecondaryContainer">@color/text_primary_light</item>
        <item name="colorErrorContainer">#FCE8E6</item>
        <item name="colorOnErrorContainer">#8B1A1A</item>
        <item name="colorSurfaceVariant">@color/surface_2_light</item>
        <item name="colorSurfaceBright">@color/surface_1_light</item>
        <item name="colorSurfaceDim">@color/surface_3_light</item>

        <item name="android:colorBackground">@color/surface_0_light</item>
        <item name="colorSurface">@color/surface_0_light</item>
        <item name="colorSurfaceContainerLowest">@color/surface_0_light</item>
        <item name="colorSurfaceContainerLow">@color/surface_1_light</item>
        <item name="colorSurfaceContainer">@color/surface_2_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_3_light</item>
        <item name="colorSurfaceContainerHighest">@color/surface_4_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>

        <item name="materialSwitchStyle">@style/Widget.InstaEclipse.Switch</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.InstaEclipse.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.InstaEclipse.BottomSheet</item>
    </style>
</resources>
