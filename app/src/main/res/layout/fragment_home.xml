<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/home_logo_ring"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.InstaEclipse.Display"
                android:textDirection="ltr" />

            <ImageButton
                android:id="@+id/home_help_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button_round"
                android:contentDescription="@string/help"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ie_help_circle"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/instagram_status_card"
            style="@style/Widget.InstaEclipse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/home_status_ring"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:layout_marginStart="-16dp"
                        android:layout_marginTop="-16dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="-16dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_module_status"
                            android:textColor="@color/ie_text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/instagram_status_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/ie_display"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/home_hook_checking"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="23sp" />

                        <LinearLayout
                            android:id="@+id/instagram_version_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_pill_chip"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="28dp"
                            android:orientation="horizontal"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:visibility="gone">

                            <View
                                android:id="@+id/module_hook_dot"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:layout_marginEnd="7dp"
                                android:background="@drawable/shape_status_dot" />

                            <TextView
                                android:id="@+id/instagram_variant_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/instagram_version_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textDirection="ltr"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/instagram_multi_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="32dp"
                            android:text="@string/multiple_versions_detected"
                            android:textColor="@color/ie_accent_text"
                            android:textFontWeight="600"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/home_status_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/home_module_inactive_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/home_actions_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launch_instagram_button"
                        style="@style/Widget.InstaEclipse.Button.SingleLine"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/launch_instagram"
                        app:icon="@drawable/ic_ie_play" />

                    <Space
                        android:id="@+id/home_actions_gap"
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/download_instagram_button"
                        style="@style/Widget.InstaEclipse.Button.Outlined.SingleLine"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/download_apk"
                        app:icon="@drawable/ic_ie_download" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_setup_guide_button"
                    style="@style/Widget.InstaEclipse.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/home_open_setup_guide"
                    android:visibility="gone"
                    app:icon="@drawable/ic_ie_chevron"
                    app:iconGravity="end" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_tip_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_chip_accent"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_ie_search"
                app:tint="@color/corona_amber" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_quick_access_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textFontWeight="600"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/home_quick_access_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:accessibilityHeading="true"
            android:text="@string/contributors"
            android:textAppearance="@style/TextAppearance.InstaEclipse.SectionLabel" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contributors_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:accessibilityHeading="true"
            android:text="@string/special_thanks"
            android:textAppearance="@style/TextAppearance.InstaEclipse.SectionLabel" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/special_thanks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            tools:ignore="UnusedAttribute" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
