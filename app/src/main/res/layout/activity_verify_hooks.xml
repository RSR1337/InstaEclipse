                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center">
                    <TextView android:id="@+id/verify_hooks_broken_count" android:textSize="22sp" android:fontFamily="@font/ie_display" android:textColor="@color/ie_danger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" />
                    <TextView android:textSize="12sp" android:textColor="?colorOnSurfaceVariant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/verify_hooks_broken_label" />
                </LinearLayout>

