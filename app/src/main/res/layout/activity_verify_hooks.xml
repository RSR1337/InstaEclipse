                    <TextView android:textSize="12sp" android:textColor="?colorOnSurfaceVariant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/verify_hooks_disabled_label" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:textSize="13.0sp" android:textColor="?colorOnSurfaceVariant" android:id="@+id/verify_hooks_status" android:paddingHorizontal="16.0dp" android:paddingBottom="16.0dp" android:text="@string/verify_hooks_loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_marginHorizontal="16.0dp" android:layout_weight="1.0" style="@style/SubmenuCard">
