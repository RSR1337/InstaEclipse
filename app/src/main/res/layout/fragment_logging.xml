<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/logging"
            android:textAppearance="@style/TextAppearance.InstaEclipse.ScreenTitle" />

        <TextView
            android:id="@+id/logging_paused_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_accent"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/logging_paused"
            android:textColor="@color/corona_amber_on"
            android:textFontWeight="600"
            android:textSize="12sp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_pause"
            style="@style/Widget.InstaEclipse.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/logging_pause"
            app:icon="@drawable/ic_ie_pause" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_copy"
            style="@style/Widget.InstaEclipse.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/logging_copy"
            app:icon="@drawable/ic_ie_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_share"
            style="@style/Widget.InstaEclipse.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/logging_share"
            app:icon="@drawable/ic_ie_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_clear"
            style="@style/Widget.InstaEclipse.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/logging_clear"
            app:icon="@drawable/ic_ie_trash"
            app:iconTint="@color/ie_danger" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_segmented"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_source_instagram"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/logging_instagram"
            android:textColor="@color/ie_tab_fg"
            android:textFontWeight="600"
            android:textSize="14sp"
            app:backgroundTint="@color/ie_tab_bg"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_source_companion"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/logging_companion"
            android:textColor="@color/ie_tab_fg"
            android:textFontWeight="600"
            android:textSize="14sp"
            app:backgroundTint="@color/ie_tab_bg"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/logging_search_card"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ie_search"
            app:tint="@color/ie_text_muted" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/logging_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/logging_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/ie_text_muted"
            android:textSize="14.5sp" />

        <ImageButton
            android:id="@+id/logging_search_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logging_search_clear"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ie_close"
            android:visibility="gone"
            app:tint="@color/ie_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/logging_filter_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/logging_filter_all"
                style="@style/Widget.InstaEclipse.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/logging_filter_all"
                app:chipIcon="@drawable/dot_muted" />

            <com.google.android.material.chip.Chip
                android:id="@+id/logging_filter_issues"
                style="@style/Widget.InstaEclipse.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logging_filter_issues"
                app:chipIcon="@drawable/dot_gold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/logging_filter_errors"
                style="@style/Widget.InstaEclipse.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logging_filter_errors"
                app:chipIcon="@drawable/dot_danger" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/logging_line_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/ie_text_muted"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/ie_log_bg"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ie_log_border"
        app:strokeWidth="1dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/logging_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="12dp"
            android:paddingBottom="64dp">

            <TextView
                android:id="@+id/logging_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.55"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/logging_placeholder"
                android:textAppearance="@style/TextAppearance.InstaEclipse.Mono"
                android:textColor="@color/ie_log_text"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="11.5sp" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/logging_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/logging_empty_help_cta"
                android:textColor="@color/ie_text_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logging_empty_help_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/help" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logging_jump_latest"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/logging_jump_latest"
            android:textFontWeight="600"
            android:textSize="13.5sp"
            android:visibility="gone"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_ie_arrow_down"
            app:iconPadding="6dp"
            app:iconSize="17dp" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
