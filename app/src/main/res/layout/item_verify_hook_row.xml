<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12.0dp" android:gravity="center_vertical"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/row_state_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null" />

    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:textSize="14.0sp" android:textColor="?colorOnSurface" android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
        <TextView android:textSize="12.0sp" android:textColor="?colorOnSurfaceVariant" android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
